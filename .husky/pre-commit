#!/bin/sh
set -e

STAGED=$(git diff --cached --name-only)

# Lint core if any core/src source files staged
if echo "$STAGED" | grep -qE "^packages/core/src/.*\.(ts|js)$"; then
  echo "[pre-commit] Linting core..."
  npm run lint -w @birthday-planner/core
fi

# Lint ui if any ui/src source files staged
if echo "$STAGED" | grep -qE "^packages/ui/src/.*\.(ts|tsx|js|jsx)$"; then
  echo "[pre-commit] Linting ui..."
  npm run lint -w @birthday-planner/ui
fi

# Validate schema if schema.prisma staged
if echo "$STAGED" | grep -q "packages/core/prisma/schema.prisma"; then
  echo "[pre-commit] Validating Prisma schema..."
  npm exec -w @birthday-planner/core -- prisma validate
fi

echo "[pre-commit] All checks passed."

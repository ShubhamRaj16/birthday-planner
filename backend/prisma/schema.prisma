generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Child {
  id        Int      @id @default(autoincrement())
  name      String
  dob       DateTime
  photo     String?
  interests String?
  allergies String?
  school    String?
  events    Event[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("children")
}

model Event {
  id              Int          @id @default(autoincrement())
  childId         Int          @map("child_id")
  child           Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  date            DateTime
  venue           String?
  address         String?
  theme           String?
  budget          Float?
  status          String       @default("Draft")
  myGateLink      String?      @map("my_gate_link")
  cardPath        String?      @map("card_path")
  messageTemplate String?      @map("message_template")
  notes              String?
  googlePhotosUrl    String?      @map("google_photos_url")
  tasks              Task[]
  reminders          Reminder[]
  guests             Guest[]
  expenses           Expense[]
  gifts              Gift[]
  photos             Photo[]
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("events")
}

model Photo {
  id          Int      @id @default(autoincrement())
  eventId     Int      @map("event_id")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  storagePath String   @map("storage_path")
  caption     String?
  isCover     Boolean  @default(false) @map("is_cover")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@map("photos")
}

model Task {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String
  category  String
  dueDate   DateTime? @map("due_date")
  done      Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tasks")
}

model Reminder {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  triggerAt DateTime @map("trigger_at")
  fired     Boolean  @default(false)
  label     String
  type      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reminders")
}

model Guest {
  id            Int       @id @default(autoincrement())
  eventId       Int       @map("event_id")
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  ageGroup      String?   @map("age_group")      // adult / child
  dietary       String?
  rsvp          String    @default("Pending")    // Pending / Confirmed / Declined
  inviteSent    Boolean   @default(false)        @map("invite_sent")
  inviteSentAt  DateTime? @map("invite_sent_at")
  notes         String?
  createdAt     DateTime  @default(now())        @map("created_at")
  updatedAt     DateTime  @updatedAt             @map("updated_at")

  @@map("guests")
}

model Expense {
  id          Int       @id @default(autoincrement())
  eventId     Int       @map("event_id")
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label       String
  amount      Float
  category    String    // venue / catering / cake / decorations / return gifts / entertainment / photography / invites/printing / miscellaneous
  paid        Boolean   @default(false)
  receiptPath String?   @map("receipt_path")
  date        DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt      @map("updated_at")

  @@map("expenses")
}

model Gift {
  id          Int      @id @default(autoincrement())
  eventId     Int      @map("event_id")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float?
  source      String   @default("manual")   // manual / ai
  status      String   @default("idea")     // idea / bought / received
  givenBy     String?  @map("given_by")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@map("gifts")
}

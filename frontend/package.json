{
  "name": "birthday-planner-frontend",
  "version": "1.0.0",
  "description": "Birthday Planner frontend — React SSR with Webpack and styled-components",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node scripts/dev.cjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "webpack --config config/webpack.client.cjs --mode production",
    "build:server": "webpack --config config/webpack.server.cjs --mode production",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "clean": "rm -rf dist",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "react",
    "ssr",
    "webpack",
    "styled-components",
    "birthday-planner"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.5",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.1",
    "react-router-dom": "^6.14.0",
    "recharts": "^2.8.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.0",
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/register": "^7.22.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.17",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "babel-loader": "^9.1.2",
    "babel-plugin-styled-components": "^2.1.4",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "style-loader": "^3.3.4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2",
    "webpack-node-externals": "^3.0.0"
  }
}

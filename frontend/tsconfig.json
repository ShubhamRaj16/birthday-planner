{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"]
  },
  "//": "Phased migration: strict typecheck covers the data layer (types, lib, redux). SSR server (src/server) and UI (.jsx) compile via webpack/Babel and migrate to strict TS in a later phase.",
  "include": [
    "src/types.ts",
    "src/lib/**/*.ts",
    "src/redux/**/*.ts",
    "src/server/**/*.ts",
    "src/services/**/*.ts",
    "src/routes/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
